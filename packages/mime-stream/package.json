{
  "name": "@portable/mime-stream",
  "description": "Walk a MIME message as a stream of parts and write it back out byte for byte, in any JavaScript runtime.",
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/mime-stream"
  },
  "keywords": [
    "mime",
    "email",
    "multipart",
    "rfc2046",
    "rfc5322",
    "streams",
    "web-streams",
    "mailsplit"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@portable/bytes": "workspace:*",
    "@portable/mime-headers": "workspace:*"
  },
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
