{
  "name": "@portable/crypto",
  "description": "Bytes-in, bytes-out helpers over WebCrypto: digest, HMAC, HKDF, Ed25519 and X25519 seeds, and ECDSA signature formats.",
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/crypto"
  },
  "keywords": [
    "crypto",
    "webcrypto",
    "subtle",
    "hmac",
    "hkdf",
    "sha256",
    "ed25519",
    "x25519",
    "ecdsa",
    "der",
    "jose",
    "ecdsa-sig-formatter"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
