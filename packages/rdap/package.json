{
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "name": "@portable/rdap",
  "description": "Look up domains, IP addresses, and AS numbers over RDAP, with IANA bootstrap and normalized results, in any JavaScript runtime.",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/rdap"
  },
  "keywords": [
    "rdap",
    "whois",
    "domain",
    "ip",
    "asn",
    "registrar",
    "rfc9083",
    "rfc9224"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@portable/errors": "workspace:*",
    "@portable/idna": "workspace:*",
    "@portable/ip": "workspace:*",
    "@portable/timers": "workspace:*"
  },
  "exports": {
    ".": {
      "src": "./src/exports/index.ts",
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    }
  },
  "main": "./dist/exports/index.js",
  "module": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts"
}
