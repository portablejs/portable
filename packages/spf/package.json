{
  "name": "@portable/spf",
  "description": "Evaluate SPF (RFC 7208) for a sender IP, HELO name and MAIL FROM domain, in any JavaScript runtime.",
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/spf"
  },
  "keywords": [
    "spf",
    "rfc7208",
    "email",
    "smtp",
    "mailauth",
    "sender-policy-framework",
    "dmarc"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@portable/dns": "workspace:*",
    "@portable/errors": "workspace:*",
    "@portable/idna": "workspace:*",
    "@portable/ip": "workspace:*",
    "@portable/timers": "workspace:*"
  },
  "exports": {
    ".": {
      "src": "./src/exports/index.ts",
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    }
  },
  "main": "./dist/exports/index.js",
  "module": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts"
}
