{
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "name": "@portable/sockets",
  "description": "Open TCP and TLS connections with the WinterTC Sockets API, in any JavaScript runtime that has a TCP socket API.",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/sockets"
  },
  "keywords": [
    "socket",
    "sockets",
    "tcp",
    "tls",
    "starttls",
    "wintertc",
    "cloudflare-workers"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@portable/bytes": "workspace:*",
    "@portable/errors": "workspace:*"
  },
  "exports": {
    ".": {
      "src": "./src/exports/index.ts",
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    },
    "./node": {
      "src": "./src/exports/node.ts",
      "types": "./dist/exports/node.d.ts",
      "default": "./dist/exports/node.js"
    }
  },
  "main": "./dist/exports/index.js",
  "module": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts"
}
