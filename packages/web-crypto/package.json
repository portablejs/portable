{
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "name": "@portable/web-crypto",
  "description": "Use WebCrypto with bytes in and out to compute digests, HMACs, and HKDF keys; derive Ed25519 and X25519 keys from seeds; import PEM keys; and convert ECDSA signature formats, in any JavaScript runtime.",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/web-crypto"
  },
  "keywords": [
    "crypto",
    "webcrypto",
    "subtle",
    "hmac",
    "hkdf",
    "sha256",
    "ed25519",
    "x25519",
    "ecdsa",
    "der",
    "jose",
    "ecdsa-sig-formatter"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@portable/bytes": "workspace:*",
    "@portable/errors": "workspace:*"
  },
  "exports": {
    ".": {
      "src": "./src/exports/index.ts",
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    },
    "./internal": {
      "src": "./src/exports/internal.ts",
      "types": "./dist/exports/internal.d.ts",
      "default": "./dist/exports/internal.js"
    }
  },
  "main": "./dist/exports/index.js",
  "module": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts"
}
