{
  "name": "@portable/webhooks",
  "description": "Verify and sign Standard Webhooks, Stripe, GitHub, Slack and Svix webhooks, in any JavaScript runtime.",
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "[!start-pkg]": "",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "dependencies": {
    "@portable/base64": "workspace:^"
  },
  "peerDependencies": {
    "@noble/hashes": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@noble/hashes": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/webhooks"
  },
  "keywords": [
    "webhooks",
    "webhook",
    "signature",
    "hmac",
    "standard-webhooks",
    "standardwebhooks",
    "stripe",
    "github",
    "slack",
    "svix"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "src": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
