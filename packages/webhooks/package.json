{
  "name": "@portable/webhooks",
  "description": "Verify and sign Standard Webhooks, Stripe, GitHub, and Slack webhooks, or any HMAC-SHA256 sender, in any JavaScript runtime.",
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/webhooks"
  },
  "keywords": [
    "webhooks",
    "webhook",
    "signature",
    "hmac",
    "standard-webhooks",
    "standardwebhooks",
    "stripe",
    "github",
    "slack",
    "svix"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@portable/base64": "workspace:*",
    "@portable/bytes": "workspace:*",
    "@portable/errors": "workspace:*",
    "@portable/timers": "workspace:*",
    "@portable/web-crypto": "workspace:*"
  },
  "exports": {
    ".": {
      "src": "./src/exports/index.ts",
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    }
  },
  "main": "./dist/exports/index.js",
  "module": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts"
}
