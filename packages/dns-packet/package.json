  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "devDependencies": {
    "@types/dns-packet": "^5.6.5",
    "@types/node": "^26.6.5",
    "dns-packet": "^5.6.1"
  },
  "[!start-pkg]": "",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/dns-packet"
  },
  "keywords": [
    "dns",
    "dns-packet",
    "packet",
    "encoding",
    "doh",
    "edns",
