{
  "name": "@portable/smtp",
  "description": "Send email over SMTP with STARTTLS, AUTH and pipelining, in any JavaScript runtime that has a TCP socket API.",
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/smtp"
  },
  "keywords": [
    "smtp",
    "lmtp",
    "email",
    "mail",
    "nodemailer",
    "cloudflare-workers",
    "sockets"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@portable/base64": "workspace:*",
    "@portable/bytes": "workspace:*",
    "@portable/errors": "workspace:*"
  },
  "exports": {
    ".": {
      "src": "./src/exports/index.ts",
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    }
  },
  "main": "./dist/exports/index.js",
  "module": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts"
}
