{
  "name": "@portable/charset",
  "description": "Encode text into legacy charsets such as Shift_JIS, GBK and windows-1251, in any JavaScript runtime.",
  "scripts": {
    "build": "zile",
    "dev": "zile dev",
    "generate": "node scripts/generate.ts"
  },
  "[!start-pkg]": "",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/charset"
  },
  "keywords": [
    "charset",
    "encoding",
    "iconv",
    "iconv-lite",
    "shift_jis",
    "gbk",
    "gb18030",
    "big5",
    "euc-kr",
    "euc-jp",
    "iso-2022-jp",
    "windows-1252",
    "whatwg"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@portable/errors": "workspace:*",
    "@portable/streams": "workspace:*"
  },
  "exports": {
    ".": {
      "src": "./src/exports/index.ts",
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    },
    "./single-byte": {
      "src": "./src/exports/single-byte.ts",
      "types": "./dist/exports/single-byte.d.ts",
      "default": "./dist/exports/single-byte.js"
    },
    "./shift_jis": {
      "src": "./src/exports/shift_jis.ts",
      "types": "./dist/exports/shift_jis.d.ts",
      "default": "./dist/exports/shift_jis.js"
    },
    "./euc-jp": {
      "src": "./src/exports/euc-jp.ts",
      "types": "./dist/exports/euc-jp.d.ts",
      "default": "./dist/exports/euc-jp.js"
    },
    "./iso-2022-jp": {
      "src": "./src/exports/iso-2022-jp.ts",
      "types": "./dist/exports/iso-2022-jp.d.ts",
      "default": "./dist/exports/iso-2022-jp.js"
    },
    "./gbk": {
      "src": "./src/exports/gbk.ts",
      "types": "./dist/exports/gbk.d.ts",
      "default": "./dist/exports/gbk.js"
    },
    "./big5": {
      "src": "./src/exports/big5.ts",
      "types": "./dist/exports/big5.d.ts",
      "default": "./dist/exports/big5.js"
    },
    "./euc-kr": {
      "src": "./src/exports/euc-kr.ts",
      "types": "./dist/exports/euc-kr.d.ts",
      "default": "./dist/exports/euc-kr.js"
    },
    "./utf-16": {
      "src": "./src/exports/utf-16.ts",
      "types": "./dist/exports/utf-16.d.ts",
      "default": "./dist/exports/utf-16.js"
    }
  },
  "main": "./dist/exports/index.js",
  "module": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts"
}
