{
  "name": "@portable/timers",
  "description": "Sleep, retry with backoff, and poll, with AbortSignal support, in any JavaScript runtime.",
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/timers"
  },
  "keywords": [
    "sleep",
    "delay",
    "wait",
    "retry",
    "backoff",
    "exponential-backoff",
    "poll",
    "abortsignal",
    "p-retry",
    "async-retry",
    "p-wait-for"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
