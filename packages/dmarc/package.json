{
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "name": "@portable/dmarc",
  "description": "Evaluate DMARC policy and identifier alignment (RFC 9989) from SPF and DKIM results, in any JavaScript runtime.",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/dmarc"
  },
  "keywords": [
    "dmarc",
    "dmarcbis",
    "rfc9989",
    "rfc7489",
    "email",
    "spf",
    "dkim",
    "mailauth"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@portable/dns": "workspace:*",
    "@portable/idna": "workspace:*",
    "@portable/spf": "workspace:*",
    "@portable/timers": "workspace:*"
  },
  "exports": {
    ".": {
      "src": "./src/exports/index.ts",
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    }
  },
  "main": "./dist/exports/index.js",
  "module": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts"
}
