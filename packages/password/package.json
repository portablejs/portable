{
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "name": "@portable/password",
  "description": "Hash and verify passwords with PBKDF2 on WebCrypto, in any JavaScript runtime.",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/password"
  },
  "keywords": [
    "password",
    "hash",
    "pbkdf2",
    "phc",
    "passlib",
    "webcrypto",
    "pbkdf2-password"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@portable/base64": "workspace:*",
    "@portable/bytes": "workspace:*",
    "@portable/errors": "workspace:*",
    "@portable/timers": "workspace:*"
  },
  "exports": {
    ".": {
      "src": "./src/exports/index.ts",
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    }
  },
  "main": "./dist/exports/index.js",
  "module": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts"
}
