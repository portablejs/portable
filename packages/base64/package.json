{
  "name": "@portable/base64",
  "description": "base64 and base64url encoding with MIME line wrapping and streams, in any JavaScript runtime.",
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "base64-js": "^1.5.1",
    "js-base64": "^3.9.4",
    "libbase64": "^1.3.3"
  },
  "[!start-pkg]": "",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/base64"
  },
  "keywords": [
    "base64",
    "base64url",
    "mime",
    "libbase64",
    "base64-js",
    "js-base64",
    "streams",
    "web-streams"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src",
    "!src/_test"
  ],
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
