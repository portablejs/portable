{
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "name": "@portable/exif",
  "description": "Read EXIF metadata from JPEG, TIFF, PNG, WebP, HEIC, and AVIF bytes or streams, and strip it from JPEG, PNG, and WebP, in any JavaScript runtime.",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/exif"
  },
  "keywords": [
    "exif",
    "tiff",
    "gps",
    "jpeg",
    "heic",
    "webp",
    "metadata",
    "exif-parser"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@portable/bytes": "workspace:*",
    "@portable/errors": "workspace:*",
    "@portable/streams": "workspace:*"
  },
  "exports": {
    ".": {
      "src": "./src/exports/index.ts",
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    }
  },
  "main": "./dist/exports/index.js",
  "module": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts"
}
