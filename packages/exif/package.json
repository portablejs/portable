{
  "name": "@portable/exif",
  "description": "Read EXIF metadata from JPEG, TIFF, PNG, WebP, HEIC and AVIF bytes, in any JavaScript runtime.",
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "exif-parser": "^0.1.12",
    "exif-reader": "^2.0.3",
    "exifr": "^7.1.3"
  },
  "[!start-pkg]": "",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/exif"
  },
  "keywords": [
    "exif",
    "tiff",
    "gps",
    "jpeg",
    "heic",
    "webp",
    "metadata",
    "exif-parser"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src",
    "!src/_test"
  ],
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
