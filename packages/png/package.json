{
  "name": "@portable/png",
  "description": "Decode PNG files to RGBA pixels and encode RGBA pixels to PNG, in any JavaScript runtime.",
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/png"
  },
  "keywords": [
    "png",
    "image",
    "decode",
    "encode",
    "pngjs",
    "rgba",
    "compressionstream"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@portable/bytes": "workspace:*",
    "@portable/errors": "workspace:*"
  },
  "exports": {
    ".": {
      "src": "./src/exports/index.ts",
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    }
  },
  "main": "./dist/exports/index.js",
  "module": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts"
}
