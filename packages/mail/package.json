{
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "name": "@portable/mail",
  "description": "Compose raw RFC 5322 email messages as web streams, in any JavaScript runtime.",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/mail"
  },
  "keywords": [
    "email",
    "mail",
    "mime",
    "rfc5322",
    "rfc2045",
    "multipart",
    "attachments",
    "nodemailer",
    "mailcomposer",
    "web-streams"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@portable/base64": "workspace:*",
    "@portable/bytes": "workspace:*",
    "@portable/errors": "workspace:*",
    "@portable/idna": "workspace:*",
    "@portable/mime-headers": "workspace:*",
    "@portable/quoted-printable": "workspace:*",
    "@portable/timers": "workspace:*"
  },
  "exports": {
    ".": {
      "src": "./src/exports/index.ts",
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    }
  },
  "main": "./dist/exports/index.js",
  "module": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts"
}
