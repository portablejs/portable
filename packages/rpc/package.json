{
  "name": "@portable/rpc",
  "description": "Call typed JSON-RPC 2.0 methods over MessagePort, windows, WebSocket and HTTP, with streaming results, in any JavaScript runtime.",
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/rpc"
  },
  "keywords": [
    "rpc",
    "json-rpc",
    "jsonrpc",
    "postmessage",
    "iframe",
    "worker",
    "messageport",
    "comlink",
    "birpc",
    "penpal"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@portable/errors": "workspace:*",
    "@portable/jsonl": "workspace:*"
  },
  "exports": {
    ".": {
      "src": "./src/exports/index.ts",
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    }
  },
  "main": "./dist/exports/index.js",
  "module": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts"
}
