  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/web-push"
  },
  "keywords": [
    "web-push",
    "push",
    "notifications",
    "push-notifications",
    "vapid",
    "aes128gcm",
    "rfc8291",
    "rfc8292",
    "webcrypto"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
