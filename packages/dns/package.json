{
  "name": "@portable/dns",
  "description": "DNS lookups over DNS-over-HTTPS, behind a resolver interface that node:dns/promises also fits, in any JavaScript runtime.",
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/dns"
  },
  "keywords": [
    "dns",
    "doh",
    "dns-over-https",
    "resolver",
    "resolveTxt",
    "resolveMx",
    "rfc8484"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@portable/base64": "workspace:*",
    "@portable/dns-packet": "workspace:*",
    "@portable/errors": "workspace:*",
    "@portable/idna": "workspace:*",
    "@portable/ip": "workspace:*"
  },
  "exports": {
    ".": {
      "src": "./src/exports/index.ts",
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    }
  },
  "main": "./dist/exports/index.js",
  "module": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts"
}
