{
  "name": "@portable/json-stream",
  "description": "Read values at paths from a large JSON stream, and write JSON from promises and streams, in any JavaScript runtime.",
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/json-stream"
  },
  "keywords": [
    "json",
    "jsonpath",
    "streaming",
    "JSONStream",
    "stream-json",
    "json-stream-stringify",
    "web-streams"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@portable/errors": "workspace:*"
  },
  "exports": {
    ".": {
      "src": "./src/exports/index.ts",
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    }
  },
  "main": "./dist/exports/index.js",
  "module": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts"
}
