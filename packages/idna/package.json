{
  "scripts": {
    "build": "zile",
    "dev": "zile dev",
    "generate": "node scripts/generate.ts"
  },
  "[!start-pkg]": "",
  "name": "@portable/idna",
  "description": "Convert internationalized domain names between Unicode and Punycode (UTS #46), in any JavaScript runtime.",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/idna"
  },
  "keywords": [
    "idna",
    "uts46",
    "tr46",
    "punycode",
    "domain",
    "hostname",
    "url",
    "unicode"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@portable/errors": "workspace:*"
  },
  "exports": {
    ".": {
      "src": "./src/exports/index.ts",
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    },
    "./internal": {
      "src": "./src/exports/internal.ts",
      "types": "./dist/exports/internal.d.ts",
      "default": "./dist/exports/internal.js"
    }
  },
  "main": "./dist/exports/index.js",
  "module": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts"
}
