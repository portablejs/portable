{
  "scripts": {
    "build": "zile",
    "dev": "zile dev"
  },
  "[!start-pkg]": "",
  "name": "@portable/random",
  "description": "Generate unbiased random integers, strings, and shuffles from crypto.getRandomValues, with a seeded generator for tests, in any JavaScript runtime.",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/portablejs/portable.git",
    "directory": "packages/random"
  },
  "keywords": [
    "random",
    "random-int",
    "crypto-random-string",
    "nanoid",
    "seedrandom",
    "shuffle",
    "prng",
    "xoshiro",
    "getRandomValues"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "src": "./src/exports/index.ts",
      "types": "./dist/exports/index.d.ts",
      "default": "./dist/exports/index.js"
    }
  },
  "main": "./dist/exports/index.js",
  "module": "./dist/exports/index.js",
  "types": "./dist/exports/index.d.ts"
}
