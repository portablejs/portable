{
  "name": "portable-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter './packages/*' build",
    "dev": "pnpm --filter './packages/*' dev",
    "check": "vp check --fix",
    "check:types": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vp test run",
    "test:changed": "vp test run --changed origin/main --project node --testTimeout=120000",
    "test:browser": "vp test run --project browser",
    "test:bun": "bun --bun node_modules/vite-plus/bin/vp test run --project node conformance",
    "test:deno": "deno run --allow-all \"$(dirname \"$(realpath node_modules/vite-plus)\")/vitest/vitest.mjs\" run --project node conformance",
    "coverage": "vp test run --project node --coverage",
    "fuzz": "vp test run --project node --mode fuzz --testTimeout=3600000 fuzz.conformance",
    "readme": "pnpm bench && node scripts/bundle-size.ts && node scripts/readme-stats.ts",
    "bench": "pnpm build && node scripts/bench.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && pnpm test && pnpm test:browser && pnpm --filter './packages/*' exec zile publish:prepare && changeset publish && pnpm --filter './packages/*' exec zile publish:post",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "zile": "catalog:"
  },
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=24"
  }
}
